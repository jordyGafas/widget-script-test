---
const navItems = [
    { linkText: 'Home', href: '/' },
    { linkText: 'About', href: '#about' },
    { linkText: 'Platform', href: '#platform' },
    { linkText: 'Services', href: '#services' },
    { linkText: 'Contact', href: '#contact' }
];
---

<header class="fixed top-0 left-0 right-0 z-50 transition-all duration-300" id="main-header">
    <div class="w-full px-6 sm:px-8 lg:px-12">
        <nav class="flex items-center justify-between h-20 max-w-7xl mx-auto">
            <a href="/" class="logo-link flex items-center gap-3 group">
                <div class="flex items-center justify-center w-10 h-10 rounded-lg bg-primary font-bold text-white text-xl transition-transform duration-300 group-hover:scale-105">
                    F
                </div>
                <span class="text-xl font-bold tracking-tight text-white">Finvictum</span>
            </a>

            <div class="hidden md:flex items-center gap-1">
                {navItems.map((item) => (
                    <a
                        href={item.href}
                        class="nav-link px-4 py-2 text-sm font-medium text-text-secondary hover:text-white transition-colors duration-200 rounded-lg hover:bg-white/5"
                    >
                        {item.linkText}
                    </a>
                ))}
                <a
                    href="https://app.finvictum.com"
                    class="nav-link ml-4 px-5 py-2 text-sm font-semibold text-white bg-primary rounded-lg hover:bg-primary-light transition-all duration-300"
                    style="box-shadow: 0 2px 10px rgba(212, 32, 48, 0.3);"
                >
                    Login Platform
                </a>
            </div>

            <button
                class="md:hidden flex flex-col gap-1.5 p-2 rounded-lg hover:bg-white/5 transition-colors"
                id="mobile-menu-btn"
                aria-label="Toggle menu"
            >
                <span class="block w-5 h-0.5 bg-white transition-transform duration-200" id="bar1"></span>
                <span class="block w-5 h-0.5 bg-white transition-opacity duration-200" id="bar2"></span>
                <span class="block w-5 h-0.5 bg-white transition-transform duration-200" id="bar3"></span>
            </button>
        </nav>
    </div>

    <div class="hidden md:hidden" id="mobile-menu">
        <div class="px-6 pb-6 pt-2 border-t border-white/10">
            <div class="flex flex-col gap-1">
                {navItems.map((item) => (
                    <a
                        href={item.href}
                        class="nav-link px-4 py-3 text-sm font-medium text-text-secondary hover:text-white transition-colors rounded-lg hover:bg-white/5"
                    >
                        {item.linkText}
                    </a>
                ))}
                <a
                    href="https://app.finvictum.com"
                    class="nav-link mt-2 px-5 py-3 text-sm font-semibold text-white bg-primary rounded-lg text-center hover:bg-primary-light transition-all duration-300"
                >
                    Login Platform
                </a>
            </div>
        </div>
    </div>
</header>

<div class="h-20"></div>

<script>
    const header = document.getElementById('main-header');
    const mobileBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const bar1 = document.getElementById('bar1');
    const bar2 = document.getElementById('bar2');
    const bar3 = document.getElementById('bar3');
    let isOpen = false;

    window.addEventListener('scroll', () => {
        if (window.scrollY > 20) {
            header?.classList.add('bg-dark/90', 'backdrop-blur-xl', 'border-b', 'border-white/5');
        } else {
            header?.classList.remove('bg-dark/90', 'backdrop-blur-xl', 'border-b', 'border-white/5');
        }
    });

    mobileBtn?.addEventListener('click', () => {
        isOpen = !isOpen;
        mobileMenu?.classList.toggle('hidden');
        if (isOpen) {
            bar1!.style.transform = 'rotate(45deg) translate(3px, 3px)';
            bar2!.style.opacity = '0';
            bar3!.style.transform = 'rotate(-45deg) translate(3px, -3px)';
        } else {
            bar1!.style.transform = '';
            bar2!.style.opacity = '1';
            bar3!.style.transform = '';
        }
    });

    document.querySelectorAll('#mobile-menu a').forEach(link => {
        link.addEventListener('click', () => {
            mobileMenu?.classList.add('hidden');
            isOpen = false;
            bar1!.style.transform = '';
            bar2!.style.opacity = '1';
            bar3!.style.transform = '';
        });
    });
</script>
