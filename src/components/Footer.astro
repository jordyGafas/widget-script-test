---

---

<footer class="relative border-t border-white/[0.06]" id="contact">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
        <div class="py-16 sm:py-20">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 lg:gap-8">
                <!-- Brand column -->
                <div class="lg:col-span-1">
                    <a href="/" class="logo-link flex items-center gap-3 mb-6 group">
                        <div class="flex items-center justify-center w-10 h-10 rounded-lg bg-primary font-bold text-white text-xl transition-transform group-hover:scale-105">
                            F
                        </div>
                        <span class="text-xl font-bold tracking-tight text-white">Finvictum</span>
                    </a>
                    <p class="text-text-muted text-sm leading-relaxed mb-6">
                        Direct communication between companies and stakeholders. Transparent, compliant, and efficient.
                    </p>
                    <div class="flex gap-3">
                        <a href="https://www.linkedin.com/company/finvictum" target="_blank" rel="noopener" class="footer-link flex items-center justify-center w-9 h-9 rounded-lg bg-white/5 hover:bg-primary/20 hover:border-primary/30 border border-white/10 transition-all duration-200" aria-label="LinkedIn">
                            <svg class="w-4 h-4 text-text-secondary" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                        </a>
                    </div>
                </div>

                <!-- Platform column -->
                <div>
                    <h4 class="text-white font-semibold text-sm uppercase tracking-wider mb-5">Platform</h4>
                    <ul class="space-y-3">
                        <li><a href="#platform" class="footer-link text-text-muted text-sm hover:text-white transition-colors">Features</a></li>
                        <li><a href="#services" class="footer-link text-text-muted text-sm hover:text-white transition-colors">Services</a></li>
                        <li><a href="https://app.finvictum.com" class="footer-link text-text-muted text-sm hover:text-white transition-colors">Login</a></li>
                        <li><a href="#" class="footer-link text-text-muted text-sm hover:text-white transition-colors">Mobile App</a></li>
                    </ul>
                </div>

                <!-- Company column -->
                <div>
                    <h4 class="text-white font-semibold text-sm uppercase tracking-wider mb-5">Company</h4>
                    <ul class="space-y-3">
                        <li><a href="#about" class="footer-link text-text-muted text-sm hover:text-white transition-colors">About</a></li>
                        <li><a href="#" class="footer-link text-text-muted text-sm hover:text-white transition-colors">Academy</a></li>
                        <li><a href="#" class="footer-link text-text-muted text-sm hover:text-white transition-colors">Privacy Policy</a></li>
                        <li><a href="#" class="footer-link text-text-muted text-sm hover:text-white transition-colors">Terms of Use</a></li>
                    </ul>
                </div>

                <!-- Contact column -->
                <div>
                    <h4 class="text-white font-semibold text-sm uppercase tracking-wider mb-5">Contact</h4>
                    <ul class="space-y-3">
                        <li class="flex items-start gap-3">
                            <svg class="w-4 h-4 mt-0.5 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                            <span class="text-text-muted text-sm">Sint Pietersvliet 7<br/>2000 Antwerpen, Belgium</span>
                        </li>
                        <li class="flex items-center gap-3">
                            <svg class="w-4 h-4 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                            <a href="mailto:info@finvictum.com" class="footer-link text-text-muted text-sm hover:text-white transition-colors">info@finvictum.com</a>
                        </li>
                        <li class="flex items-center gap-3">
                            <svg class="w-4 h-4 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                            <a href="tel:+32479915367" class="footer-link text-text-muted text-sm hover:text-white transition-colors">+32 479 91 53 67</a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Bottom bar -->
        <div class="border-t border-white/[0.06] py-6 flex flex-col sm:flex-row items-center justify-between gap-4">
            <p class="text-text-muted text-xs">&copy; {new Date().getFullYear()} Finvictum BV. All rights reserved.</p>
            <p class="text-text-muted text-xs">Supported by imec iStart</p>
        </div>
    </div>
</footer>
